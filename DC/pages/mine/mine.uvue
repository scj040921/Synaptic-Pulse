<template>
  <view class="page">
    <scroll-view direction="vertical" class="scroll">
      <view class="frame">
        <text class="eyebrow">YOUR SPACE</text>
        <text class="page-title">我的画像</text>
        <text class="muted">展示真实的兴趣，比填写完美的人设更容易找到同频者。</text>

        <view class="surface profile-head">
          <view class="avatar"><text class="avatar-letter">{{ (profile.displayName || '隙').slice(0, 1) }}</text></view>
          <view><text class="name">{{ profile.displayName || '同学' }}</text><text class="muted">{{ profile.campus || '广州大学' }} · 体验账号</text></view>
        </view>

        <view class="surface form">
          <text class="section-title">编辑个人资料</text>
          <text class="label">昵称</text>
          <input class="field" v-model="displayName" maxlength="40" placeholder="你希望大家怎么称呼你" />
          <text class="label">自我介绍</text>
          <textarea class="textarea" v-model="bio" maxlength="300" placeholder="说说最近喜欢的事情…" />
          <text class="label">兴趣标签</text>
          <input class="field" v-model="interestsText" placeholder="用逗号分隔，如 摄影, 篮球, 编程" />
          <text class="muted hint">最多 10 个标签，每个最多 30 字。标签会用于当前的共同兴趣推荐。</text>
          <text v-if="message" class="feedback">{{ message }}</text>
          <view class="primary-btn save" @click="save"><text class="primary-label">{{ saving ? '保存中…' : '保存资料' }}</text></view>
        </view>

        <view class="surface info">
          <text class="section-title">项目体验说明</text>
          <text class="muted info-copy">当前版本没有校园身份核验和附近定位。请勿在公开动态中填写电话、宿舍地址等个人信息。</text>
        </view>
        <view class="logout" @click="logout"><text class="logout-label">退出登录</text></view>
      </view>
    </scroll-view>
    <CustomTabBar />
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onPageShow } from '@dcloudio/uni-app'
import CustomTabBar from '@/components/CustomTabBar.uvue'
import { api, clearToken, ensureLogin } from '@/common/api.js'
const profile = ref({ displayName: '', campus: '' })
const displayName = ref('')
const bio = ref('')
const interestsText = ref('')
const message = ref('')
const saving = ref(false)

onPageShow(async () => {
  uni.hideTabBar()
  if (!ensureLogin()) return
  try {
    const data = await api('/me')
    profile.value = data
    displayName.value = data.displayName
    bio.value = data.bio
    interestsText.value = data.interests.join(', ')
  } catch (e) { message.value = e.message }
})

async function save() {
  if (saving.value) return
  saving.value = true
  message.value = ''
  try {
    const interests = interestsText.value.split(/[,，]/).map(item => item.trim()).filter(Boolean)
    profile.value = await api('/me', 'PUT', { displayName: displayName.value, bio: bio.value, interests })
    message.value = '资料已保存'
  } catch (e) { message.value = e.message }
  finally { saving.value = false }
}
async function logout() {
  try { await api('/auth/logout', 'POST') } catch (_) {}
  clearToken()
  uni.reLaunch({ url: '/pages/auth/auth' })
}
</script>

<style scoped>
.scroll { flex: 1; }
.profile-head { flex-direction: row; align-items: center; margin-top: 28px; }
.avatar { width: 60px; height: 60px; border-radius: 19px; background-color: #d9f1e9; justify-content: center; align-items: center; margin-right: 15px; }
.avatar-letter { color: #2d746d; font-size: 26px; font-weight: 700; }
.name { font-size: 20px; color: #1a2c44; font-weight: 700; margin-bottom: 4px; }
.form { margin-top: 15px; }
.label { color: #4c5e75; font-size: 12px; font-weight: 700; margin-top: 21px; }
.textarea { width: 100%; height: 92px; background-color: #f4f6fb; border-radius: 12px; padding: 12px 14px; box-sizing: border-box; margin-top: 10px; font-size: 14px; color: #19223b; }
.hint { margin-top: 9px; }
.feedback { margin-top: 12px; color: #397b73; font-size: 12px; }
.save { margin-top: 23px; }
.info-copy { margin-top: 11px; }
.logout { align-items: center; margin-top: 22px; }
.logout-label { color: #9a5d6a; font-size: 13px; }
</style>
