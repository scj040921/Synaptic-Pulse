<template>
  <view class="page">
    <scroll-view direction="vertical" class="scroll">
      <view class="frame">
        <view class="top-row">
          <view>
            <text class="eyebrow">SYNAPTIC PULSE · 广州大学</text>
            <text class="page-title">你好，{{ me.displayName || '同学' }}</text>
            <text class="muted">今天也许能遇见聊得来的人。</text>
          </view>
          <view class="avatar" @click="goMine"><text class="avatar-letter">{{ (me.displayName || '隙').slice(0, 1) }}</text></view>
        </view>

        <view class="hero">
          <text class="hero-overline">你的校园共鸣实验室</text>
          <text class="hero-title">从一个共同兴趣，开始一场好对话。</text>
          <text class="hero-copy">完善兴趣标签后，发现更多同频的校园伙伴。</text>
          <view class="hero-actions">
            <view class="hero-button" @click="goProfile"><text class="hero-button-label">完善画像 ↗</text></view>
            <view class="hero-link" @click="goTraining"><text class="hero-link-label">社交练习 →</text></view>
          </view>
          <view class="orb orb-one"></view><view class="orb orb-two"></view>
        </view>

        <view class="section-head">
          <text class="section-title">同频推荐</text>
          <text class="muted">根据共同兴趣排序</text>
        </view>
        <view v-if="loading" class="surface empty"><text class="empty-label">正在寻找同频的人…</text></view>
        <view v-else-if="matches.length === 0" class="surface empty"><text class="empty-label">还没有可推荐的人。邀请朋友创建账号并添加兴趣，或先完善你的兴趣标签。</text></view>
        <view v-else class="match-grid">
          <view class="surface match-card" v-for="match in matches" :key="match.user.id">
            <view class="match-top">
              <view class="small-avatar"><text class="avatar-letter">{{ match.user.displayName.slice(0, 1) }}</text></view>
              <view class="score"><text class="score-label">{{ match.score }}% 共鸣</text></view>
            </view>
            <text class="match-name">{{ match.user.displayName }}</text>
            <text class="muted match-bio">{{ match.user.bio || '还没有写自我介绍' }}</text>
            <view class="tag-list">
              <text class="pill" v-for="tag in match.commonInterests" :key="tag">{{ tag }}</text>
              <text v-if="match.commonInterests.length === 0" class="muted">暂时没有共同标签</text>
            </view>
            <view class="secondary-btn match-action" @click="openChat(match.user.id)"><text class="secondary-label">发起对话 →</text></view>
          </view>
        </view>

        <view class="section-head"><text class="section-title">校园新动态</text><text class="text-link" @click="goCircle">进入社区 →</text></view>
        <view class="surface post-preview" v-for="post in posts" :key="post.id">
          <text class="preview-name">{{ post.authorName }}</text>
          <text class="preview-content">{{ post.content }}</text>
        </view>
        <view v-if="error" class="surface"><text class="error">{{ error }}</text></view>
      </view>
    </scroll-view>
    <CustomTabBar />
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onPageShow } from '@dcloudio/uni-app'
import CustomTabBar from '@/components/CustomTabBar.uvue'
import { api, ensureLogin } from '@/common/api.js'

const me = ref({ displayName: '' })
const matches = ref([])
const posts = ref([])
const loading = ref(false)
const error = ref('')

onPageShow(async () => {
  uni.hideTabBar()
  if (!ensureLogin()) return
  loading.value = true
  error.value = ''
  try {
    const [profile, people, feed] = await Promise.all([api('/me'), api('/matches'), api('/posts')])
    me.value = profile
    matches.value = people
    posts.value = feed.slice(0, 2)
  } catch (e) { error.value = e.message }
  finally { loading.value = false }
})

function openChat(id) { uni.navigateTo({ url: '/pages/conversation/conversation?id=' + id }) }
function goMine() { uni.switchTab({ url: '/pages/mine/mine' }) }
function goProfile() { goMine() }
function goCircle() { uni.switchTab({ url: '/pages/circle/circle' }) }
function goTraining() { uni.navigateTo({ url: '/pages/training/training' }) }
</script>

<style scoped>
.scroll { flex: 1; }
.top-row { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 14px; }
.avatar, .small-avatar { background-color: #d6eee8; justify-content: center; align-items: center; border-radius: 18px; }
.avatar { width: 48px; height: 48px; }
.avatar-letter { color: #286d68; font-size: 20px; font-weight: 700; }
.hero { background-color: #1d2c46; border-radius: 26px; padding: 28px; margin-top: 27px; overflow: hidden; position: relative; }
.hero-overline { font-size: 11px; letter-spacing: 2px; color: #a7f1df; }
.hero-title { font-size: 26px; line-height: 36px; color: #ffffff; font-weight: 700; margin-top: 15px; max-width: 520px; z-index: 2; }
.hero-copy { color: #adbed0; font-size: 13px; margin-top: 10px; z-index: 2; }
.hero-actions { flex-direction: row; align-items: center; margin-top: 25px; z-index: 2; }
.hero-button { padding: 12px 17px; border-radius: 11px; background-color: #a7f1df; }
.hero-button-label { color: #20334a; font-size: 13px; font-weight: 700; }
.hero-link { padding: 12px 16px; }
.hero-link-label { color: #ffffff; font-size: 13px; }
.orb { position: absolute; border-radius: 100%; background-color: rgba(137, 229, 209, .11); }
.orb-one { width: 180px; height: 180px; right: -42px; top: -80px; }
.orb-two { width: 90px; height: 90px; right: 75px; bottom: -48px; }
.section-head { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 32px; }
.match-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.match-card { width: 100%; max-width: 440px; box-sizing: border-box; }
.match-top { flex-direction: row; justify-content: space-between; align-items: center; }
.small-avatar { width: 42px; height: 42px; border-radius: 14px; }
.score { background-color: #f2e9fb; border-radius: 20px; padding: 6px 10px; }
.score-label { color: #78539e; font-size: 11px; }
.match-name { font-size: 18px; font-weight: 700; color: #1a2740; margin-top: 15px; }
.match-bio { margin-top: 5px; }
.tag-list { flex-direction: row; flex-wrap: wrap; min-height: 43px; margin-top: 8px; }
.match-action { margin-top: 14px; align-self: flex-start; }
.text-link { color: #397b73; font-size: 12px; }
.post-preview { margin-top: 12px; }
.preview-name { font-weight: 700; color: #24334b; font-size: 13px; }
.preview-content { font-size: 14px; line-height: 22px; color: #4a5a70; margin-top: 7px; }
.error { color: #bd4a59; font-size: 13px; }
</style>
