<template>
  <view class="page">
    <scroll-view direction="vertical" class="scroll">
      <view class="frame">
        <text class="eyebrow">CONVERSATIONS</text>
        <text class="page-title">消息</text>
        <text class="muted">从共同话题开始，慢慢认识彼此。</text>
        <view v-if="loading" class="surface empty"><text class="empty-label">正在加载消息…</text></view>
        <view v-else-if="chats.length === 0" class="surface empty"><text class="empty-label">还没有对话。去共鸣页找到感兴趣的同学，发出第一句问候吧。</text></view>
        <view class="surface chat-row" v-for="chat in chats" :key="chat.peer.id" @click="open(chat.peer.id)">
          <view class="avatar"><text class="avatar-letter">{{ chat.peer.displayName.slice(0, 1) }}</text></view>
          <view class="chat-info">
            <text class="name">{{ chat.peer.displayName }}</text>
            <text class="muted snippet">{{ chat.lastMessage.content }}</text>
          </view>
          <text class="chevron">›</text>
        </view>
        <view v-if="error" class="surface"><text class="error">{{ error }}</text></view>
      </view>
    </scroll-view>
    <CustomTabBar />
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onPageShow } from '@dcloudio/uni-app'
import CustomTabBar from '@/components/CustomTabBar.uvue'
import { api, ensureLogin } from '@/common/api.js'
const chats = ref([])
const loading = ref(false)
const error = ref('')
onPageShow(async () => {
  uni.hideTabBar()
  if (!ensureLogin()) return
  loading.value = true
  try { chats.value = await api('/chats'); error.value = '' }
  catch (e) { error.value = e.message }
  finally { loading.value = false }
})
function open(id) { uni.navigateTo({ url: '/pages/conversation/conversation?id=' + id }) }
</script>

<style scoped>
.scroll { flex: 1; }
.chat-row { flex-direction: row; align-items: center; margin-top: 12px; }
.avatar { width: 48px; height: 48px; border-radius: 16px; background-color: #e4f3f0; justify-content: center; align-items: center; margin-right: 14px; }
.avatar-letter { color: #287870; font-size: 19px; font-weight: 700; }
.chat-info { flex: 1; }
.name { font-size: 15px; color: #1e304b; font-weight: 700; }
.snippet { margin-top: 5px; }
.chevron { font-size: 26px; color: #9aacc0; }
.error { color: #bd4a59; font-size: 13px; }
</style>
