<template>
  <view class="page">
    <scroll-view direction="vertical" class="scroll">
      <view class="frame">
        <text class="eyebrow">CAMPUS COMMUNITY</text>
        <text class="page-title">校园社区</text>
        <text class="muted">聊聊兴趣、分享发现，也许下一个话题就能遇到同频的人。</text>
        <view class="compose-card" @click="publish">
          <view class="compose-dot"><text class="compose-dot-icon">✦</text></view>
          <text class="compose-prompt">分享一件校园里的新鲜事…</text>
          <text class="compose-arrow">→</text>
        </view>
        <view class="section-head"><text class="section-title">最新动态</text><text class="muted">最多显示 50 条</text></view>
        <view v-if="loading" class="surface empty"><text class="empty-label">正在加载社区动态…</text></view>
        <view v-else-if="posts.length === 0" class="surface empty"><text class="empty-label">还没有动态。来发布第一条吧。</text></view>
        <view class="surface post" v-for="post in posts" :key="post.id">
          <view class="author-row">
            <view class="avatar"><text class="avatar-letter">{{ post.authorName.slice(0, 1) }}</text></view>
            <view><text class="author-name">{{ post.authorName }}</text><text class="muted">{{ post.createdAt.replace('T', ' ').slice(0, 16) }}</text></view>
          </view>
          <text class="content">{{ post.content }}</text>
        </view>
        <view v-if="error" class="surface"><text class="error">{{ error }}</text></view>
      </view>
    </scroll-view>
    <CustomTabBar />
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onPageShow } from '@dcloudio/uni-app'
import CustomTabBar from '@/components/CustomTabBar.uvue'
import { api, ensureLogin } from '@/common/api.js'

const posts = ref([])
const loading = ref(false)
const error = ref('')
onPageShow(async () => {
  uni.hideTabBar()
  if (!ensureLogin()) return
  loading.value = true
  try { posts.value = await api('/posts'); error.value = '' }
  catch (e) { error.value = e.message }
  finally { loading.value = false }
})
function publish() { uni.navigateTo({ url: '/pages/publish/publish' }) }
</script>

<style scoped>
.scroll { flex: 1; }
.compose-card { background-color: #dff0ea; border-radius: 19px; padding: 17px; margin-top: 26px; flex-direction: row; align-items: center; }
.compose-dot { width: 35px; height: 35px; border-radius: 12px; background-color: #ffffff; justify-content: center; align-items: center; margin-right: 12px; }
.compose-dot-icon { color: #387c75; font-size: 21px; }
.compose-prompt { color: #3d6868; font-size: 13px; }
.compose-arrow { margin-left: auto; color: #3d6868; font-size: 20px; }
.section-head { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 31px; }
.post { margin-top: 12px; }
.author-row { flex-direction: row; align-items: center; }
.avatar { width: 38px; height: 38px; border-radius: 13px; background-color: #e5ecf8; justify-content: center; align-items: center; margin-right: 10px; }
.avatar-letter { color: #426188; font-size: 16px; font-weight: 700; }
.author-name { font-size: 13px; color: #22314d; font-weight: 700; }
.content { color: #344359; font-size: 15px; line-height: 25px; margin-top: 16px; }
.error { color: #bd4a59; font-size: 13px; }
</style>
