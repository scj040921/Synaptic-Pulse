<template>
  <view class="page conversation">
    <view class="thread-frame">
      <view class="thread-header">
        <text class="back" @click="back">←</text>
        <view class="peer-heading"><text class="peer-name">{{ peer.displayName || '对话' }}</text><text class="muted">体验账号 · 请尊重彼此边界</text></view>
        <text class="block" @click="blockPeer">屏蔽</text>
      </view>
      <scroll-view scroll-y class="messages" :scroll-into-view="lastAnchor">
        <view v-if="messages.length === 0" class="empty"><text>从一个共同兴趣开始吧，比如“最近在听什么歌？”</text></view>
        <view v-for="message in messages" :key="message.id" :id="'m' + message.id" class="message-row" :class="{ own: message.senderId === myId }">
          <view class="bubble" :class="{ ownBubble: message.senderId === myId }"><text>{{ message.content }}</text></view>
        </view>
      </scroll-view>
      <view v-if="error" class="error-row"><text>{{ error }}</text></view>
      <view class="composer">
        <input class="message-input" v-model="draft" maxlength="1000" placeholder="发送一条友善的消息…" confirm-type="send" @confirm="send" />
        <view class="send-btn" @click="send"><text>发送</text></view>
      </view>
    </view>
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { onLoad, onPageShow, onPageHide } from '@dcloudio/uni-app'
import { api, ensureLogin } from '@/common/api.js'

const peerId = ref(0)
const peer = ref({ displayName: '' })
const myId = ref(0)
const messages = ref([])
const draft = ref('')
const error = ref('')
const lastAnchor = ref('')
let timer = null

onLoad((options) => { peerId.value = Number(options.id) })
onPageShow(async () => {
  if (!ensureLogin() || !peerId.value) return
  try {
    const [mine, other] = await Promise.all([api('/me'), api('/users/' + peerId.value)])
    myId.value = mine.id
    peer.value = other
    await refresh()
    timer = setInterval(refresh, 5000)
  } catch (e) { error.value = e.message }
})
onPageHide(() => { if (timer) clearInterval(timer); timer = null })

async function refresh() {
  try {
    messages.value = await api('/chats/' + peerId.value + '/messages')
    if (messages.value.length) lastAnchor.value = 'm' + messages.value[messages.value.length - 1].id
    error.value = ''
  } catch (e) { error.value = e.message }
}
async function send() {
  const content = draft.value.trim()
  if (!content) return
  try {
    await api('/chats/' + peerId.value + '/messages', 'POST', { content })
    draft.value = ''
    await refresh()
  } catch (e) { error.value = e.message }
}
function back() { uni.navigateBack() }
function blockPeer() {
  uni.showModal({ title: '屏蔽此用户？', content: '屏蔽后双方无法继续聊天，你也不会看到对方的动态。', success: async (result) => {
    if (!result.confirm) return
    try { await api('/blocks/' + peerId.value, 'POST'); back() }
    catch (e) { error.value = e.message }
  } })
}
</script>

<style scoped>
.conversation { background-color: #f4f6fb; }
.thread-frame { width: 100%; max-width: 800px; height: 100vh; margin: 0 auto; background-color: #ffffff; }
.thread-header { height: 74px; flex-direction: row; align-items: center; padding: 0 20px; border-bottom: 1px solid #e9edf4; }
.back { font-size: 24px; color: #3c7772; margin-right: 20px; }
.peer-heading { flex: 1; }
.peer-name { font-size: 17px; font-weight: 700; color: #20304a; }
.block { font-size: 12px; color: #9b6472; }
.messages { flex: 1; padding: 14px 18px; box-sizing: border-box; }
.message-row { width: 100%; flex-direction: row; margin: 8px 0; }
.own { justify-content: flex-end; }
.bubble { max-width: 76%; background-color: #f0f3f8; border-radius: 16px; padding: 11px 14px; }
.bubble text { font-size: 14px; line-height: 22px; color: #314057; }
.ownBubble { background-color: #d9f2e9; }
.error-row { padding: 5px 18px; }
.error-row text { font-size: 11px; color: #bd4a59; }
.composer { flex-direction: row; padding: 12px 16px; align-items: center; border-top: 1px solid #e9edf4; padding-bottom: max(12px, env(safe-area-inset-bottom)); }
.message-input { flex: 1; height: 42px; background-color: #f3f5f9; border-radius: 12px; padding: 0 12px; font-size: 13px; }
.send-btn { background-color: #263c59; border-radius: 12px; padding: 12px 15px; margin-left: 9px; }
.send-btn text { color: #ffffff; font-size: 13px; }
</style>
