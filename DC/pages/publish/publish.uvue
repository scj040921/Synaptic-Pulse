<template>
  <view class="page">
    <view class="frame">
      <view class="back" @click="back"><text>← 返回社区</text></view>
      <text class="eyebrow">SHARE A MOMENT</text>
      <text class="page-title">发布动态</text>
      <text class="muted">分享你正在研究、喜欢或想讨论的事。</text>
      <view class="surface editor">
        <textarea v-model="content" class="input-area" maxlength="2000" placeholder="今天想分享什么？" />
        <text class="counter">{{ content.length }}/2000</text>
      </view>
      <text v-if="error" class="error">{{ error }}</text>
      <view class="primary-btn submit" @click="submit"><text>{{ busy ? '发布中…' : '发布到校园社区' }}</text></view>
    </view>
  </view>
</template>

<script setup>
import { ref } from 'vue'
import { api, ensureLogin } from '@/common/api.js'
import { onPageShow } from '@dcloudio/uni-app'

const content = ref('')
const error = ref('')
const busy = ref(false)
onPageShow(() => { ensureLogin() })
function back() { uni.switchTab({ url: '/pages/circle/circle' }) }
async function submit() {
  if (busy.value) return
  if (!content.value.trim()) { error.value = '请先写一点内容'; return }
  busy.value = true
  error.value = ''
  try {
    await api('/posts', 'POST', { content: content.value })
    content.value = ''
    back()
  } catch (e) { error.value = e.message }
  finally { busy.value = false }
}
</script>

<style scoped>
.back { margin-bottom: 27px; }
.back text { font-size: 13px; color: #397e76; }
.editor { margin-top: 27px; }
.input-area { width: 100%; min-height: 230px; font-size: 16px; line-height: 25px; color: #263650; }
.counter { color: #98a4b3; font-size: 11px; text-align: right; }
.error { color: #bd4a59; font-size: 12px; margin-top: 12px; }
.submit { margin-top: 18px; }
</style>
