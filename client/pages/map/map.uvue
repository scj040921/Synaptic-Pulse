<template>
  <view class="map-page">
    <web-view v-if="src" id="campus-map" class="map-webview" :src="src" allow="geolocation" :fullscreen="!selecting" @message="onMessage" @error="loadError" />
    <view v-if="selectionPurpose" class="selection-bar">
      <view class="selection-copy"><text class="selection-title">{{ chosenPosition ? chosenPosition.locationName : '点击地图标记地点，或选择预设地点' }}</text><text class="selection-hint">{{ chosenPosition ? '可拖动微调，确认后返回编辑页' : '选点不需要开启定位权限' }}</text></view>
      <view class="selection-controls"><view v-if="selectionPurpose !== 'place'" class="selection-center" @click="markCenter"><text class="selection-center-label">标记地图中心</text></view><view class="selection-confirm" :class="{ 'selection-disabled': !chosenPosition }" @click="confirmSelection"><text class="selection-confirm-label">确认地点</text></view></view>
    </view>
    <view v-if="error" class="map-error"><text>{{ error }}</text><text class="map-retry" @click="reload">重新加载</text><text class="map-retry" @click="back">返回</text></view>
  </view>
</template>
<script setup>
import { ref, getCurrentInstance } from 'vue'
import { onLoad, onUnload, onPageShow } from '@dcloudio/uni-app'
import { ensureLogin, serverUrl, expireSession } from '@/common/api.js'
import { campusMapUrl, finishMapSelection } from '@/common/campus-map.js'

const src = ref(''); const error = ref('')
const instance = getCurrentInstance()
const selectionPurpose = ref('')
const chosenPosition = ref<{ latitude: number, longitude: number, locationName: string, placeId: string | null } | null>(null)
let selecting = false; let placeId = ''; let locating = false; let active = true; let selected = false
let eventId = ''; let requestId = ''; let purpose = ''; let pointName = ''; const bridgeId = 'map-' + Date.now() + '-' + Math.random().toString(36).slice(2)
let pointMode = false; let latitude = ''; let longitude = ''; let postId = ''; let refreshPending = false
onLoad((options) => {
  if (!ensureLogin()) return
  selecting = options.select === '1'; placeId = options.place || ''
  pointMode = options.point === '1'; latitude = options.lat || ''; longitude = options.lng || ''; postId = options.post || ''
  eventId = options.event || ''; requestId = options.request || ''; purpose = options.purpose || ''; pointName = options.name || ''
  selecting = selecting || pointMode
  if (selecting) selectionPurpose.value = purpose || (pointMode ? 'point' : 'place')

  reload()
  // #ifdef H5
  window.addEventListener('message', receiveWeb)
  // #endif
})
onPageShow(() => { if (refreshPending) { refreshPending = false; reload() } })
onUnload(() => {
  active = false
  if (selecting && !selected) finishMapSelection(requestId, null)
  // #ifdef H5
  window.removeEventListener('message', receiveWeb)
  // #endif
})
function reload() { error.value = ''; src.value = campusMapUrl(placeId) + '&select=' + (selecting && !pointMode ? '1' : '0') + '&point=' + (pointMode ? '1' : '0') + '&lat=' + latitude + '&lng=' + longitude + '&post=' + postId + '&event=' + eventId + '&purpose=' + purpose + '&name=' + encodeURIComponent(pointName) + '&bridge=' + bridgeId + '&reload=' + Date.now() }
function back() { uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/index/index' }) }) }
function loadError() { error.value = '地图加载失败，请检查服务器地址和网络。' }
function markCenter() {
  // #ifdef H5
  const frame = instance?.proxy?.$el?.querySelector('iframe')
  if (frame) frame.contentWindow.postMessage({ channel: 'pulse-campus-command', bridge: bridgeId, action: 'pick-center' }, new URL(serverUrl()).origin)
  // #endif
  // #ifndef H5
  uni.createWebViewContext('campus-map', instance?.proxy).evalJS('window.PulseCampus.pickCenter()')
  // #endif
}
function confirmSelection() {
  if (!chosenPosition.value || selected) return
  selected = true
  const point = chosenPosition.value
  finishMapSelection(requestId, pointMode ? point : { id: point.placeId, name: point.locationName })
  back()
}
function handle(data) {
  if (!active || !data || data.channel !== 'pulse-campus' || data.bridge !== bridgeId) return
  if (data.action === 'back') back()
  if (data.action === 'expired') expireSession()
  if (data.action === 'events') uni.navigateTo({ url: '/pages/events/events' })
  if (data.action === 'post' && Number.isSafeInteger(data.id) && data.id > 0) {
    refreshPending = true
    uni.navigateTo({ url: '/pages/post/post?id=' + data.id })
  }
  if (data.action === 'selection' && !data.position) chosenPosition.value = null
  if ((data.action === 'publish' || data.action === 'point' || data.action === 'selection') && data.position) {
    const p = data.position
    if (!Number.isFinite(p.latitude) || !Number.isFinite(p.longitude) || Math.abs(p.latitude) > 90 || Math.abs(p.longitude) > 180) return
    const position = { latitude: p.latitude, longitude: p.longitude, locationName: String(p.locationName || '地图标记').slice(0, 80), placeId: typeof p.placeId === 'string' ? p.placeId : null }
    if (data.action === 'selection') { chosenPosition.value = position; return }
    if (data.action === 'point' && pointMode) {
      selected = true; finishMapSelection(requestId, position); back()
    } else if (data.action === 'publish' && !selecting) {
      uni.navigateTo({ url: '/pages/publish/publish?fromMap=1&lat=' + position.latitude + '&lng=' + position.longitude + '&name=' + encodeURIComponent(position.locationName),
        events: { postPublished: (post) => { postId = String(post.id); latitude = ''; longitude = ''; placeId = ''; refreshPending = true } } })
    }
  }
  if (data.action === 'select' && selecting && data.place && typeof data.place.id === 'string') {
    selected = true
    finishMapSelection(requestId, { id: data.place.id, name: data.place.name })
    back()
  }
  if (data.action === 'locate') locateNative()
}
function onMessage(event) { (event.detail.data || []).forEach(handle) }
// #ifdef H5
function receiveWeb(event) {
  if (event.origin !== new URL(serverUrl()).origin) return
  const frame = instance?.proxy?.$el?.querySelector('iframe')
  if (!frame || event.source !== frame.contentWindow) return
  handle(event.data)
}
// #endif
function locateNative() {
  // #ifndef H5
  if (locating) return
  locating = true
  uni.getLocation({ type: 'wgs84', success: (position) => {
    if (!active) return
    uni.createWebViewContext('campus-map', instance?.proxy).evalJS('window.PulseCampus.setLocation(' + JSON.stringify({ latitude: position.latitude, longitude: position.longitude, accuracy: position.accuracy }) + ')')
  }, fail: () => {
    if (active) uni.createWebViewContext('campus-map', instance?.proxy).evalJS('window.PulseCampus.locationFailed()')
  }, complete: () => { locating = false } })
  // #endif
}
</script>
<style scoped>
.selection-bar { flex-direction: row; align-items: center; padding: 13px 20px; background-color: #ffffff; border-top-width: 1px; border-top-color: #e8edf2; border-top-style: solid; }
.selection-copy { flex: 1; margin-right: 12px; }.selection-title { color: #29445c; font-size: 13px; font-weight: 700; }.selection-hint { color: #78899b; font-size: 11px; margin-top: 5px; }
.selection-confirm { padding: 12px 16px; border-radius: 12px; background-color: #2b655e; }.selection-confirm-label { color: #ffffff; font-size: 13px; }.selection-disabled { background-color: #aab8b7; }
.selection-controls { flex-direction: row; align-items: center; }.selection-center { padding: 12px 10px; margin-right: 8px; border-radius: 12px; background-color: #eaf5f1; }.selection-center-label { color: #34766d; font-size: 12px; }
.map-page { flex: 1; background-color: #f4f6fb; }.map-webview { flex: 1; width: 100%; height: 100%; }.map-error { position: absolute; top: 80px; left: 20px; right: 20px; padding: 20px; background-color: #ffffff; border-radius: 16px; }.map-retry { margin-top: 16px; color: #397b73; }
</style>
