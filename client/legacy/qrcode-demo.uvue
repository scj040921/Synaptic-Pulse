	<view class="qr-root">
		<view class="particle-container">
			<view v-for="i in 15" :key="i" :class="'particle p' + i"></view>
		</view>

		<view class="status-bar"></view>
		
		<view class="nav-bar">
			<text class="back-btn" @click="goBack">✕</text>
			<text class="nav-title">数字身份密钥</text>
			<text class="expand-icon">⛶</text>
		</view>

		<view class="card-container">
			<view class="profile-card">
				<view class="glass-bg"></view>
				
				<view class="card-header">
					<image class="mini-avatar" src="/static/avatar.png" mode="aspectFill"></image>
					<view class="user-info">
						<view class="name-box">
							<text class="name-text">KEVVV</text>
							<view class="level-pill">Lv.8</view>
						</view>
						<view class="tag-row">
							<text class="status-tag tag-pink">突触先锋</text>
							<text class="status-tag tag-purple">脑波同频者</text>
						</view>
					</view>
				</view>

				<view class="qr-box">
					<view class="scan-corner corner-tl"></view>
					<view class="scan-corner corner-tr"></view>
					<view class="scan-corner corner-bl"></view>
					<view class="scan-corner corner-br"></view>
					
					<canvas class="qr-canvas" canvas-id="myLocalQrcode" id="myLocalQrcode"></canvas>
					
					<view class="qr-logo-center">
						<text class="logo-icon">⚛</text>
					</view>
					
					<view class="scan-line-pink"></view>
				</view>

				<view class="id-section">
					<text class="id-label">ID:</text>
					<text class="id-value">SYN-12138</text>
				</view>

				<text class="bottom-tips">扫一扫，同步神经脉冲</text>
			</view>
		</view>

		<view class="footer-capsule">
			<view class="action-item" @click="saveImage">
				<text class="action-icon">💾</text>
				<text class="action-label">保存名片</text>
			</view>
			<view class="v-divider"></view>
			<view class="action-item">
				<text class="action-icon">🎨</text>
				<text class="action-label">更换皮肤</text>
			</view>
		</view>
		
		<view class="safe-bottom"></view>
	</view>
</template>

<script setup>
import { onMounted, getCurrentInstance } from 'vue';

const goBack = () => { uni.navigateBack() };

// 你的 ID 数据
const userId = "SYN-12138";

/**
 * 零依赖、纯 UTS 本地二维码生成核心逻辑
 * 为了让你秒看见，我们将逻辑内联进代码中。
 */
const drawLocalPinkQrCode = () => {
	// 这里我们需要一个轻量级的开源二维码核心逻辑。由于不能用插件市场，我这里简化一下演示调用。
	// 在实际真机环境中，由于 UTS 不具备标准浏览器的文本算法，纯内联逻辑会比较复杂且不稳定。
	
	// 如果你追求极速、本地化，且坚决不用插件市场：
	// 最稳妥的方案依然是在网上搜索“uts二维码纯代码生成”，将该算法文件 (.uts) 手动放入项目的 SDK 目录中进行调用。
	
	// 这里我先为你搭建好 Canvas 调用的框架，保证你在静态视觉上不仅能看见，布局也是对的：
	const ctx = uni.createCanvasContext('myLocalQrcode');
	
	// 在没有真正算法文件之前，为了让你能立马“看见”UI 布局效果，我手动在 Canvas 里画个粉色格子占位。
	// 当你放入真正的算法文件时，只需将 qr.drawCanvas() 的逻辑写在这里即可。
	ctx.setFillStyle("#1a1b2e"); // 匹配深色底色
	ctx.fillRect(0, 0, 190, 190);
	
	// 演示：画一个简单的粉色色块模拟
	ctx.setFillStyle("#f8b9d4");
	ctx.fillRect(40, 40, 110, 110);
	
	ctx.draw();
	console.log("二维码本地 Canvas UI 已准备就绪");
};

onMounted(() => {
	// 延迟一下确保组件已挂载
	setTimeout(() => {
		drawLocalPinkQrCode();
	}, 150);
});

const saveImage = () => {
	uni.showToast({ title: '已保存至相册', icon: 'success' });
};
</script>

